# ==============================================================================
# GovPilot-X — Frontend Environment Configuration (.env)
# Copy this file to `frontend/.env` and fill in your actual values.
# ==============================================================================

# ─── Backend API Connection ───────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000

# ─── Supabase (Database + File Storage) ───────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Bucket name you created in Supabase Dashboard → Storage
VITE_SUPABASE_STORAGE_BUCKET=govpilot-documents
