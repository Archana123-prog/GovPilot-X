# ==============================================================================
# GovPilot-X — Frontend Environment Configuration (.env)
# Copy this file to `frontend/.env` and update the values for your environment.
# ==============================================================================

# ─── Backend API Connection ───────────────────────────────────────────────────
# Base URL where FastAPI backend is running
VITE_API_BASE=http://localhost:8000

# ─── Firebase Storage (Document & Evidence Uploads) ───────────────────────────
# Get these values from Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=govpilot-x.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=govpilot-x
VITE_FIREBASE_STORAGE_BUCKET=govpilot-x.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
