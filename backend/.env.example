# ==============================================================================
# GovPilot-X — Backend Environment Configuration (.env)
# Copy this file to `backend/.env` and update the values for your environment.
# ==============================================================================

# ─── Application Settings ─────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=replace-this-with-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/govpilotx

# ─── Redis (for Celery background workers) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Google Gemini AI Matching & Evaluation ───────────────────────────────────
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─── Vector Search Thresholds ─────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.78
TOP_K_RESULTS=10

# ─── Firebase Storage (Document & Evidence Storage) ───────────────────────────
# Used for storing pilot agreements, milestone evidence, and validation reports
FIREBASE_PROJECT_ID=govpilot-x
FIREBASE_STORAGE_BUCKET=govpilot-x.appspot.com
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
