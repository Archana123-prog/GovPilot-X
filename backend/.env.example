# ==============================================================================
# GovPilot-X — Backend Environment Configuration (.env)
# Copy this file to `backend/.env` and fill in your actual values.
# ==============================================================================

# ─── Application Settings ─────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=replace-this-with-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Supabase (Database + Storage) ────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# PostgreSQL connection via Supabase (use Session mode pooler on port 5432)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql+asyncpg://postgres.your-project-id:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── Supabase Storage (Document & Evidence Storage) ───────────────────────────
# Create a bucket in: Supabase Dashboard → Storage → New Bucket
SUPABASE_STORAGE_BUCKET=govpilot-documents

# ─── Redis (for Celery background workers) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Google Gemini AI Matching & Evaluation ───────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─── Vector Search Thresholds ─────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.78
TOP_K_RESULTS=10

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
